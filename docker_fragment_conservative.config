# Docker 内核特性配置片段 (保守版)
# 在 raphael_defconfig 基础上叠加
# 与激进版区别:
#   - 关闭 NF_TABLES: 让 Docker 使用 iptables-legacy, 避免与高通 iptables 模块冲突
#   - 关闭 USER_NS: 避免被银行/支付 App 检测到 user namespace, 牺牲 --userns-remap
#   - 关闭 CHECKPOINT_RESTORE: Android 用不到, 减小 Image 大小, 减少攻击面

# === Namespaces (Docker 容器隔离基础) ===
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
# CONFIG_USER_NS is not set  # 保守: 关闭, 避免 App 检测
CONFIG_UTS_NS=y

# === Cgroups (Docker 资源限制) ===
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_MEMCG=y
CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y

# === Network (容器网络) ===
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
# CONFIG_NF_TABLES is not set  # 保守: 关闭, 让 Docker 用 iptables-legacy
CONFIG_NETFILTER=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH_TAB_BITS=8
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_PROC_COMPAT=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_NEEDED=y

# === Filesystem (Docker 镜像层) ===
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y

# === Misc ===
CONFIG_POSIX_MQUEUE=y
CONFIG_BINFMT_MISC=y
# CONFIG_CHECKPOINT_RESTORE is not set  # 保守: 关闭, 减小 Image
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y
CONFIG_KEYS_DEBUG_PROC_KEYS=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_SHA256=y
# CONFIG_COMPAT is not set
# CONFIG_COMPAT_VDSO is not set
